POSTGRES_DB=beework
POSTGRES_USER=beework
POSTGRES_PASSWORD=beework_local_only
DATABASE_URL=postgresql+psycopg://beework:beework_local_only@postgres:5432/beework
VALKEY_URL=redis://valkey:6379/0
# Optional regional package index for backend image builds.
PIP_INDEX_URL=
AUTH_SECRET=local-only-change-this-secret-before-deploying
MODEL_CREDENTIALS_SECRET=local-only-model-credentials-secret
AUTH_COOKIE_SECURE=false
APP_ORIGIN=http://localhost:5173
ENVIRONMENT=development
BOOTSTRAP_TENANT_NAME=Acme 科技
BOOTSTRAP_TENANT_SLUG=acme
BOOTSTRAP_ADMIN_EMAIL=admin@beework.dev
BOOTSTRAP_ADMIN_NAME=Olivia Lin
BOOTSTRAP_ADMIN_PASSWORD=Beework-Dev-2026!
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=platform@beework.dev
BOOTSTRAP_PLATFORM_ADMIN_NAME=BeeWork Platform Admin
BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=BeeWork-Platform-2026!
# AI gateway (LiteLLM, runs in Compose). Change both secrets outside local development.
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-beework-local-only-master
LITELLM_SALT_KEY=sk-beework-local-only-salt
# Knowledge engine for NEW knowledge bases: dify (default) or ragflow (optional, not verified against a real instance).
# Each knowledge base keeps the engine it was created with.
KNOWLEDGE_ENGINE=dify
# Dify (Cloud: https://api.dify.ai/v1, or self-hosted); the key is the workspace "Knowledge API" key (dataset-...).
DIFY_BASE_URL=
DIFY_API_KEY=
# RAGFlow (optional): deployed separately with its official Compose (needs >=16 GB RAM) or RAGFlow Cloud.
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=
# Tracing (Langfuse Cloud or a separately deployed Langfuse).
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Outbound mail (T-008). MAIL_TRANSPORT=smtp delivers over SMTP (in Compose the default points at
# the local Mailpit catcher, Web UI http://127.0.0.1:8025); "console" only logs a masked line.
# Outside development set real provider values here — never commit them.
MAIL_TRANSPORT=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
MAIL_FROM=BeeWork <no-reply@beework.local>

# Public base URL of the API as browsers see it (embed code, widget script). Set it behind a proxy / in production.
PUBLIC_API_URL=

# PII / safety detectors (T-055, optional). A classifier rule needs Presidio; an LLM-judge rule needs a LiteLLM model alias.
PRESIDIO_ANALYZER_URL=
PRESIDIO_LANGUAGE=en
SAFETY_JUDGE_MODEL=

# Outbound proxy for the AI gateway (LiteLLM container). Needed for providers blocked from your network, e.g. Gemini.
# Use host.docker.internal, not 127.0.0.1 (inside a container 127.0.0.1 is the container). Leave empty for direct access.
LITELLM_OUTBOUND_PROXY=
